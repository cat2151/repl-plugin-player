set(sysex_dir "${CMAKE_CURRENT_LIST_DIR}")
set(sysex_input "${REPL_PROJECT_ROOT}/target/shim/generated/clap-note-dialect/PluginInstanceCLAP.cpp")
set(sysex_output "${REPL_PROJECT_ROOT}/target/shim/clap-sysex-input/PluginInstanceCLAP.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${sysex_input}")

function(sysex_fail detail)
    execute_process(COMMAND git -C "${UAPMD_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT revision)
        set(revision "unknown")
    endif()
    message(FATAL_ERROR "[clap-sysex-input] target: ${sysex_input}; ${detail}; UAPMD revision: ${revision}; instructions: ${sysex_dir}/README.md")
endfunction()

# Replaces `anchor` in the variable `text` with `replacement`; stops unless it occurs exactly once.
function(sysex_once anchor replacement)
    string(REPLACE "${anchor}" "" without "${text}")
    string(LENGTH "${text}" with_length)
    string(LENGTH "${without}" without_length)
    string(LENGTH "${anchor}" anchor_length)
    math(EXPR count "(${with_length} - ${without_length}) / ${anchor_length}")
    if(NOT count EQUAL 1)
        sysex_fail("expected '${anchor}' once, found ${count}")
    endif()
    string(REPLACE "${anchor}" "${replacement}" replaced "${text}")
    set(text "${replaced}" PARENT_SCOPE)
endfunction()

file(READ "${sysex_input}" text)
sysex_once("#include <umppi/umppi.hpp>\n"
    "#include \"${sysex_dir}/clap_sysex_input.hpp\"\n#include <umppi/umppi.hpp>\n")
sysex_once("    PluginInstanceCLAP::~PluginInstanceCLAP() {\n"
    "    PluginInstanceCLAP::~PluginInstanceCLAP() {\n        if (plugin) repl_clap_sysex_input::forget(plugin->clapPlugin());\n")
sysex_once("        ump_input_dispatcher.process(process);\n"
    "        repl_clap_sysex_input::drain(plugin->clapPlugin(), *events_in);\n        ump_input_dispatcher.process(process);\n")
file(WRITE "${sysex_output}.new" "${text}")
file(COPY_FILE "${sysex_output}.new" "${sysex_output}" ONLY_IF_DIFFERENT)
file(REMOVE "${sysex_output}.new")

get_target_property(sysex_before remidy SOURCES)
set(sysex_sources "")
set(sysex_replaced 0)
foreach(sysex_source IN LISTS sysex_before)
    if(sysex_source STREQUAL sysex_input)
        list(APPEND sysex_sources "${sysex_output}")
        math(EXPR sysex_replaced "${sysex_replaced} + 1")
    else()
        list(APPEND sysex_sources "${sysex_source}")
    endif()
endforeach()
if(NOT sysex_replaced EQUAL 1)
    sysex_fail("expected one remidy source, found ${sysex_replaced}")
endif()
list(APPEND sysex_sources "${sysex_dir}/sysex_input.cpp")
set_property(TARGET remidy PROPERTY SOURCES "${sysex_sources}")
