# Observe actual delivery without modifying the dependency checkout.
execute_process(COMMAND git -C "${UAPMD_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE note_monitor_revision OUTPUT_STRIP_TRAILING_WHITESPACE)
set(REPL_GRAPH_SOURCE "${UAPMD_DIR}/source/uapmd-graph/src/node-graph")
set(REPL_GRAPH_COPY "${REPL_PROJECT_ROOT}/target/shim/note-monitor")
function(note_monitor_failure target_file reason)
    message(FATAL_ERROR "note-monitor: ${target_file}: ${reason}; upstream ${note_monitor_revision}; see ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/integration.md")
endfunction()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${REPL_GRAPH_SOURCE}/AudioPluginNodeImpl.hpp")
if(NOT EXISTS "${REPL_GRAPH_SOURCE}/AudioPluginNodeImpl.hpp")
    note_monitor_failure("AudioPluginNodeImpl.hpp" "input observer target missing")
endif()
file(READ "${REPL_GRAPH_SOURCE}/AudioPluginNodeImpl.hpp" node_source)
set(note_delivery "            trackInputEvents(process.eventIn());")
set(note_member "        int32_t instance_id_;")
set(scope_output "            const auto status = instance_->processAudio(process);")
foreach(anchor IN ITEMS "${note_delivery}" "${note_member}" "${scope_output}")
    string(FIND "${node_source}" "${anchor}" anchor_position)
    if(anchor_position EQUAL -1)
        note_monitor_failure("AudioPluginNodeImpl.hpp" "expected anchor missing: ${anchor}")
    endif()
endforeach()
string(REPLACE "${note_delivery}" "${note_delivery}\n            repl_note_state_.process(instance_id_, static_cast<const uint32_t*>(process.eventIn().getMessages()), process.eventIn().position() / sizeof(uint32_t), process.frameCount());" node_source "${node_source}")
string(REPLACE "${note_member}" "        repl_notes::InputState repl_note_state_;\n${note_member}" node_source "${node_source}")
string(REPLACE "${scope_output}" "${scope_output}\n            if (status == 0) repl_capture_scope(instance_id_, process);" node_source "${node_source}")
string(PREPEND node_source "#include \"${CMAKE_CURRENT_LIST_DIR}/note_monitor.hpp\"\n")
string(PREPEND node_source "#include \"${REPL_PROJECT_ROOT}/uapmd-host/scope_capture.hpp\"\n")
file(MAKE_DIRECTORY "${REPL_GRAPH_COPY}")
file(WRITE "${REPL_GRAPH_COPY}/AudioPluginNodeImpl.hpp" "${node_source}")
get_target_property(graph_sources uapmd-graph SOURCES)
foreach(graph_file AudioPluginGraph.cpp AudioPluginFullDAGraph.cpp)
    list(FIND graph_sources "src/node-graph/${graph_file}" source_position)
    if(source_position EQUAL -1 OR NOT EXISTS "${REPL_GRAPH_SOURCE}/${graph_file}")
        note_monitor_failure("${graph_file}" "expected graph source missing")
    endif()
    configure_file("${REPL_GRAPH_SOURCE}/${graph_file}" "${REPL_GRAPH_COPY}/${graph_file}" COPYONLY)
    list(REMOVE_ITEM graph_sources "src/node-graph/${graph_file}")
    list(APPEND graph_sources "${REPL_GRAPH_COPY}/${graph_file}")
endforeach()
set_property(TARGET uapmd-graph PROPERTY SOURCES "${graph_sources}")
