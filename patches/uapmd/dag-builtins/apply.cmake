find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(dag_builtins_input "${UAPMD_DIR}/source/uapmd-graph/src/node-graph/AudioPluginFullDAGraph.cpp")
set(dag_builtins_output "${REPL_PROJECT_ROOT}/target/shim/dag-builtins/AudioPluginFullDAGraph.cpp")
set(dag_builtins_engine "${UAPMD_DIR}/source/uapmd-engine/src/sequencer/SequencerEngine.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${dag_builtins_input}" "${dag_builtins_engine}" "${CMAKE_CURRENT_LIST_DIR}/generate.py" "${CMAKE_CURRENT_LIST_DIR}/routing.hpp")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/generate.py"
    "${dag_builtins_input}" "${dag_builtins_output}" "${REPL_GRAPH_COPY}/AudioPluginNodeImpl.hpp" "${dag_builtins_engine}"
    RESULT_VARIABLE dag_builtins_result ERROR_VARIABLE dag_builtins_error)
if(NOT dag_builtins_result EQUAL 0)
    message(FATAL_ERROR "${dag_builtins_error}")
endif()
get_target_property(dag_builtins_sources uapmd-graph SOURCES)
set(dag_builtins_original "${REPL_GRAPH_COPY}/AudioPluginFullDAGraph.cpp")
list(FIND dag_builtins_sources "${dag_builtins_original}" dag_builtins_position)
if(dag_builtins_position EQUAL -1)
    message(FATAL_ERROR "dag-builtins: ${dag_builtins_input}: target source missing; expected UAPMD 9f708d3300b4a6f8109eee0fadccf286db8b7a45; see ${CMAKE_CURRENT_LIST_DIR}/README.md")
endif()
list(REMOVE_AT dag_builtins_sources ${dag_builtins_position})
list(INSERT dag_builtins_sources ${dag_builtins_position} "${dag_builtins_output}")
set_property(TARGET uapmd-graph PROPERTY SOURCES "${dag_builtins_sources}")
get_target_property(dag_builtins_engine_sources uapmd-engine SOURCES)
list(FIND dag_builtins_engine_sources "src/sequencer/SequencerEngine.cpp" dag_builtins_engine_position)
if(dag_builtins_engine_position EQUAL -1)
    message(FATAL_ERROR "dag-builtins: ${dag_builtins_engine}: target source missing; expected UAPMD 9f708d3300b4a6f8109eee0fadccf286db8b7a45; see ${CMAKE_CURRENT_LIST_DIR}/README.md")
endif()
list(REMOVE_AT dag_builtins_engine_sources ${dag_builtins_engine_position})
list(INSERT dag_builtins_engine_sources ${dag_builtins_engine_position} "${REPL_PROJECT_ROOT}/target/shim/dag-builtins/SequencerEngine.cpp")
set_property(TARGET uapmd-engine PROPERTY SOURCES "${dag_builtins_engine_sources}")
add_executable(dag_builtins_regression EXCLUDE_FROM_ALL
    "${CMAKE_CURRENT_LIST_DIR}/regression.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/event_timing_test.cpp")
target_link_libraries(dag_builtins_regression PRIVATE uapmd-graph)
get_target_property(dag_builtins_includes uapmd-graph INCLUDE_DIRECTORIES)
target_include_directories(dag_builtins_regression PRIVATE ${dag_builtins_includes})
